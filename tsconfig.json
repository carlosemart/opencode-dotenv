{
  "compilerOptions": {
    /* Entorno */
    "lib": ["ESNext"],
    "target": "ESNext",
    "types": ["node"],

    /* Resolución de módulos (estilo OpenCode) */
    "module": "Preserve",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Rigor */
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "tests"]
}
